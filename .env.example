OPENROUTER_API_KEY=
# Any OpenRouter model slug, e.g. anthropic/claude-haiku-4.5
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Key-pair auth (preferred): path to PKCS#8 private key
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fallback if no key path is set
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=LOOKER
SNOWFLAKE_SCHEMA=AI
